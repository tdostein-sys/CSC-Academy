# =============================================================================
# Plateforme CSC (thème Sneat) — variables d'environnement
#
# Copiez ce fichier en .env.local (copier, ne pas renommer), puis renseignez
# les valeurs. .env.local n'est JAMAIS commité (voir .gitignore).
# Ce fichier ne contient volontairement AUCUNE valeur : les exemples sont en
# commentaire.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : aucun secret.
# Mêmes noms de variables que le projet CSC d'origine : son .env.local
# fonctionne tel quel (les anciennes variables SEED_ADMIN_* sont ignorées).
# =============================================================================

# --- Application -------------------------------------------------------------
# URL publique de l'application (liens dans les e-mails, redirections).
# Ex. en local : http://localhost:3000 — en ligne : https://csc.example.com
# Si cette URL change, l'ajouter dans Supabase › Authentication › URL
# Configuration (Site URL, et Redirect URLs : <url>/**).
NEXT_PUBLIC_SITE_URL=
# Développement uniquement : pour ouvrir le serveur de dev par le nom de ce PC
# (ou depuis d'autres PC du réseau), nom(s) de la machine séparés par des
# virgules, sans http:// ni port. Ex. : mon-pc
DEV_ALLOWED_ORIGINS=

# --- Supabase (Project Settings › API / API Keys) ----------------------------
# La base est partagée et DÉJÀ MIGRÉE : ne relancez aucune migration.
# Ex. : https://<ref-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « publishable » (ou « anon » sur les anciens projets).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET — clé « secret » (ou « service_role »). Contourne la RLS : utilisée
# uniquement côté serveur (fichiers marqués server-only).
SUPABASE_SECRET_KEY=

# --- E-mails des notifications -----------------------------------------------
# brevo (recommandé), emailjs, ou console (développement : les e-mails sont
# affichés dans le terminal au lieu d'être envoyés). Vide = console.
EMAIL_PROVIDER=
# Nom d'expéditeur affiché. Ex. : CSC - Crypto Sans Complexe
EMAIL_FROM_NAME=

# Brevo › SMTP & API › API Keys (clé commençant par « xkeysib- »). SECRET.
BREVO_API_KEY=
# Adresse expéditrice vérifiée dans Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=

# EmailJS (alternative) — Account › General / Security, Email Services, Email Templates.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# SECRET — clé privée (« Private Key »).
EMAILJS_PRIVATE_KEY=

# --- WhatsApp (désactivé tant que l'API WhatsApp Cloud n'est pas configurée) --
# true ou false. Vide = false.
WHATSAPP_ENABLED=
WHATSAPP_PHONE_NUMBER_ID=
# SECRET
WHATSAPP_ACCESS_TOKEN=

# --- Traduction automatique des contenus (DeepL) -----------------------------
# Les contenus saisis par l'admin (campagnes, charte…) dans UNE langue sont
# traduits automatiquement dans l'autre à l'enregistrement.
# Clé gratuite : https://www.deepl.com/pro-api (offre « DeepL API Free »,
# 500 000 caractères/mois ; la clé se termine par « :fx »). SECRET.
# Vide = pas de traduction : le contenu s'affiche dans sa langue d'origine.
DEEPL_API_KEY=

# --- CSC Academy : visioconférence (LiveKit Cloud) ----------------------------
# https://cloud.livekit.io › votre projet › Settings.
# Adresse du projet (onglet Project). Ex. : wss://csc-academy-xxxx.livekit.cloud
LIVEKIT_URL=
# Onglet Keys › Create key. La clé commence par « API ». SECRET pour les deux.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- CSC Academy : stockage des enregistrements (Cloudflare R2) ---------------
# Espace privé séparé de Supabase (visionnage sans frais de bande passante).
# https://dash.cloudflare.com › R2 Object Storage.
# Ex. : https://<identifiant-du-compte>.r2.cloudflarestorage.com
RECORDINGS_S3_ENDPOINT=
# Nom du bucket. Ex. : csc-academy-recordings
RECORDINGS_S3_BUCKET=
# R2 › Manage API tokens › Create API token (« Object Read & Write », limité au bucket). SECRET.
RECORDINGS_S3_ACCESS_KEY_ID=
RECORDINGS_S3_SECRET_ACCESS_KEY=

# --- Tâches planifiées ---------------------------------------------------------
# SECRET — chaîne aléatoire longue (ex. : openssl rand -hex 32). Protège
# GET /api/cron/notifications (en-tête Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
