# =============================================================================
# Plateforme CSC — variables d'environnement
# Copiez ce fichier en .env.local (ne le renommez pas) puis renseignez les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : aucun secret.
# =============================================================================

# --- Application -------------------------------------------------------------
# URL publique de l'application (liens dans les e-mails, redirections).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings › API / API Keys) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique « publishable » (ou « anon » sur les anciens projets).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET — clé « secret » (ou « service_role »). Contourne la RLS : serveur uniquement.
SUPABASE_SECRET_KEY=

# --- Premier administrateur (npm run seed:admin) -----------------------------
SEED_ADMIN_USERNAME=csc_admin
SEED_ADMIN_EMAIL=
# SECRET — 12 caractères minimum, lettres et chiffres. Changement imposé à la
# première connexion. Peut être vidé après le seed.
SEED_ADMIN_PASSWORD=

# --- E-mails des notifications -----------------------------------------------
# brevo (recommandé, 300 e-mails/jour gratuits), emailjs, ou console (développement :
# les e-mails sont affichés dans le terminal au lieu d'être envoyés).
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=CSC - Crypto Sans Complexe

# Brevo › SMTP & API › API Keys. SECRET.
BREVO_API_KEY=
# Adresse expéditrice vérifiée dans Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=

# EmailJS (alternative) — Account › General / Security, Email Services, Email Templates.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# SECRET — clé privée (« Private Key »).
EMAILJS_PRIVATE_KEY=

# --- WhatsApp (désactivé tant que l'API WhatsApp Cloud n'est pas configurée) --
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
# SECRET
WHATSAPP_ACCESS_TOKEN=

# --- Traduction automatique des contenus (DeepL) -----------------------------
# Les contenus saisis par l'admin (campagnes, charte…) dans UNE langue sont
# traduits automatiquement dans l'autre à l'enregistrement.
# Clé gratuite : https://www.deepl.com/pro-api (offre « DeepL API Free »,
# 500 000 caractères/mois ; la clé se termine par « :fx »). SECRET.
# Vide = pas de traduction : le contenu s'affiche dans sa langue d'origine.
DEEPL_API_KEY=

# --- Tâches planifiées ---------------------------------------------------------
# SECRET — chaîne aléatoire longue (ex. : openssl rand -hex 32). Protège
# GET /api/cron/notifications (en-tête Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
